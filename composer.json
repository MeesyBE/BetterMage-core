{
    "name": "bettermagento/module-core",
    "description": "BetterMagento Core \u2014 Shared foundation for all BetterMagento modules",
    "type": "magento2-module",
    "keywords": [
        "magento2",
        "bettermagento",
        "core"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "magento/framework": "^103.0",
        "psr/log": "^3.0",
        "monolog/monolog": "^3.0",
        "magento/module-backend": "^102.0",
        "magento/module-ui": "^101.0",
        "magento/module-directory": "^100.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^2.0",
        "bitexpert/phpstan-magento": "^0.43"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "BetterMagento\\Core\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BetterMagento\\Core\\Test\\": "Test"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    ],
    "config": {
        "allow-plugins": {
            "magento/composer-dependency-version-audit-plugin": true
        }
    }
}
