{
    "name": "bettermagento/module-core",
    "description": "BetterMagento Core — Shared foundation for all BetterMagento modules",
    "type": "magento2-module",
    "keywords": [
        "magento2",
        "bettermagento",
        "core"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "magento/framework": ">=107.0.0",
        "psr/log": "^3.0",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-magento": "^0.12"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "BetterMagento\\Core\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BetterMagento\\Core\\Test\\": "Test"
        }
    }
}
