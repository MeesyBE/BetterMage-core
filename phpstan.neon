parameters:
    level: 8
    paths:
        - Api
        - Model
        - Console
        - Block
        - Ui
    excludePaths:
        - Test
    # Magento uses mixed types extensively in interfaces — tolerate at boundaries

includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - vendor/bitexpert/phpstan-magento/extension.neon

